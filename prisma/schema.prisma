// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  role        String       // 'LANDOWNER', 'FARMER', 'INVESTOR'
  name        String
  email       String       @unique
  passwordHash String?
  avatarUrl   String?
  bio         String?
  isVerified  Boolean      @default(false)
  lands       Land[]       @relation("LandOwner")
  rented      Land[]       @relation("LandRenter")
  investments Investment[]
  payments    Payment[]
  payouts     Payout[]
  messagesSent   Message[] @relation("Sender")
  messagesRecv   Message[] @relation("Receiver")
  rentalRequests RentalRequest[] @relation("FarmerRequests")
}

model Land {
  id            String       @id @default(cuid())
  ownerId       String
  renterId      String?
  name          String
  location      String
  latitude      Float?
  longitude     Float?
  imageUrl      String?
  sizeAcres     Float
  soilType      String?      // AI Generated
  suitableCrops String?      // AI Generated list
  estBudget     Float?       // AI Generated
  estYield      Float?       // AI Generated
  pesticides    String?      // AI Generated
  status        String       @default("AVAILABLE") // AVAILABLE, RENTED
  isVerified    Boolean      @default(false)
  owner         User         @relation("LandOwner", fields: [ownerId], references: [id])
  renter        User?        @relation("LandRenter", fields: [renterId], references: [id])
  investments   Investment[]
  payments      Payment[]
  payouts       Payout[]
  updates       ProjectUpdate[]
  rentalRequests RentalRequest[]
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  landId    String
  title     String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  land      Land     @relation(fields: [landId], references: [id])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  sender     User     @relation("Sender", fields: [senderId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
}

model Investment {
  id         String @id @default(cuid())
  landId     String
  investorId String
  amount     Float
  status     String @default("PENDING") // PENDING, PAID, REFUNDED
  createdAt  DateTime @default(now())
  paidAt     DateTime?
  payment    Payment?
  investor   User   @relation(fields: [investorId], references: [id])
  land       Land   @relation(fields: [landId], references: [id])
}

model Payment {
  id               String   @id @default(cuid())
  provider         String   // STRIPE
  providerRef      String   @unique // e.g. Stripe Checkout Session ID
  status           String   // CREATED, PAID, FAILED, REFUNDED
  amount           Float
  currency         String   @default("usd")
  investorId       String
  landId           String
  investmentId     String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  rawEventId       String?

  investor         User      @relation(fields: [investorId], references: [id])
  land             Land      @relation(fields: [landId], references: [id])
  investment       Investment? @relation(fields: [investmentId], references: [id])
}

model RentalRequest {
  id         String   @id @default(cuid())
  landId     String
  farmerId   String
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  message    String?
  createdAt  DateTime @default(now())
  
  land       Land     @relation(fields: [landId], references: [id])
  farmer     User     @relation("FarmerRequests", fields: [farmerId], references: [id])
}

model Payout {
  id          String   @id @default(cuid())
  investorId  String
  landId      String
  amount      Float
  currency    String   @default("usd")
  status      String   @default("PENDING") // PENDING, PAID, FAILED
  createdAt   DateTime @default(now())
  paidAt      DateTime?
  note        String?

  investor    User @relation(fields: [investorId], references: [id])
  land        Land @relation(fields: [landId], references: [id])
}
